# AI provider configuration
#
# `mock` returns canned fixtures and is only valid outside production.
# `agent-router` is the real provider and is the only value allowed in production.
AI_PROVIDER=agent-router

# AgentRouter — OpenAI-compatible LLM gateway.
#
# Server-side only. Never expose these to apps/web or any browser bundle: the
# API key must only ever be read by apps/api on the server.
#
# Verify with:  pnpm --filter @repo/api ai:verify
#                pnpm --filter @repo/api ai:verify -- --list-models
#                pnpm --filter @repo/api ai:verify-features

# Required. The API key issued by your AgentRouter account.
AGENT_ROUTER_API_KEY=

# Optional. Defaults to https://agentrouter.org/v1.
# The /v1 suffix is added automatically if you give only the host.
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1

# Required. A model your account can actually route. Confirm the exact ids with
# `pnpm --filter @repo/api ai:verify -- --list-models`.
AGENT_ROUTER_MODEL=deepseek-v4-flash

# Optional tuning.
#
# AgentRouter only serves clients it recognises: a request without an accepted
# User-Agent is answered with HTTP 401 `unauthorized_client_error` even when the
# API key is valid. The default below is known to work; override it only if
# AgentRouter asks you to.
# AGENT_ROUTER_USER_AGENT=claude-cli/2.0.14 (external, cli)

# Per-request timeout in milliseconds. Default 300000.
# AGENT_ROUTER_TIMEOUT_MS=300000

# Token budget per request. Reasoning tokens are drawn from the same budget as
# the answer, so a low value truncates long JSON responses. Raise this if you
# see "The AI response was too long to complete".
# AGENT_ROUTER_MAX_TOKENS=16384

# Ask for a JSON object. Every AI feature parses a validated JSON object, so
# leave this on. Set to false only for plain-text callers.
# AGENT_ROUTER_JSON_MODE=true

# Suppress the model's reasoning trace. Cuts completion tokens sharply and is
# what makes the larger token budget affordable. Set to false if a model needs
# to reason.
# AGENT_ROUTER_DISABLE_THINKING=true
